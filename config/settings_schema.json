[
  {
    "name": "theme_info",
    "theme_name": "NOAN",
    "theme_version": "1.0.0",
    "theme_author": "Mar Studio",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 40
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#111111",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#444444",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#F4F4F4",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#F4D6CB",
        "label": "t:labels.accent"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.contact",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "t:labels.whatsapp_number",
        "info": "t:info.whatsapp_number",
        "default": "573018430447"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "t:labels.whatsapp_message",
        "default": "Hola NOAN, quiero hacer una consulta."
      },
      {
        "type": "checkbox",
        "id": "whatsapp_floating",
        "label": "t:labels.whatsapp_floating",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.product_cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "t:labels.card_show_second_image",
        "default": true
      },
      {
        "type": "text",
        "id": "card_new_tag",
        "label": "t:labels.card_new_tag",
        "info": "t:info.card_new_tag",
        "default": "nuevo"
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      }
    ]
  }
]
